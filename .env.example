# Normally generated by the server setup (Setup-Andromeda-Server.bat / setup_server.py).
# Copy by hand only for manual deployments.
#
# STANDARD (single server, one API): Core is the only API and starts/stops the game
# server processes itself. Andromeda.Orchestrator is NOT used and needs no token.

# Resolve the router's current public IPv4 when session/join data is requested.
SERVER_IP=auto
SERVER_IP_CACHE_SECONDS=30
# Compatibility snapshot for older 0.11.1 components. The setup replaces this.
SERVER_HOST=203.0.113.10
# Where Core listens. Use 127.0.0.1 when a Cloudflare Tunnel or reverse proxy on this server fronts Core.
CORE_HOST=0.0.0.0
CORE_PORT=8000

# Game sessions run as local processes started by Core.
GAME_SESSION_PROVIDER=local
GAME_RUNTIME_MODE=process
# Absolute path to the modded (MelonLoader + Andromeda.Mod) game server executable.
GAME_EXECUTABLE_PATH=C:\AndromedaServer\gameserver\game\enemy-on-board.exe
# Core URL the game servers report to (same machine).
GAME_SESSION_API_URL=http://127.0.0.1:8000
# Game + voice ports (UDP, plus TCP for the game channel). Open them in every firewall.
GAME_PORT_RANGE_START=7777
GAME_PORT_RANGE_END=7977
MAX_EOB_INSTANCES=6
GAME_HOST_BOOT_PROVIDER=none

# Admin access. Replace this before exposing Core publicly.
ADMIN_PASSWORD=change-me

# Steam Web API key (https://steamcommunity.com/dev/apikey) used to verify Steam logins.
STEAM_API_KEY=
STEAM_APP_ID=999860

# Optional extras, off by default.
ENABLE_LANDING_PAGE=false
# Legacy TCP client-log collector. The API and admin site work without it.
ENABLE_LOG_SERVER=false
LOG_SERVER_PORT=9090
ENABLE_UPNP=false
ENABLE_API_REQUEST_LOGGING=false

# ADVANCED multi-host mode only (Core + Andromeda.Orchestrator on game hosts):
# GAME_SESSION_PROVIDER=host-api
# GAME_HOST_API_BASE_URL=http://game-host.internal:9000
# GAME_HOST_API_TOKEN=<must match HOST_API_TOKEN in the Orchestrator's .env>
# GAME_HOST_API_TIMEOUT_SECONDS=8
