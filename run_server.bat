@echo off
setlocal enabledelayedexpansion

:: Runs Andromeda Core on Windows. When the server setup (setup_server.py, run by
:: Setup-Andromeda-Server.bat) has configured this folder (venv + generated .env)
:: it starts Core directly; otherwise it falls back to the original bootstrap below.
:: Servers set up with the bundle normally use the generated start_andromeda.bat.

cd /d "%~dp0"

echo.
echo ==========================================
echo    Andromeda Server Bootstrapper
echo ==========================================
echo.

set "PY=python"
if exist "venv\Scripts\python.exe" set "PY=venv\Scripts\python.exe"

set "MANAGED=0"
:: Matches both "Generated by Andromeda server setup" and older generated files.
if exist ".env" findstr /b /c:"# Generated by Andromeda" ".env" >nul 2>nul && set "MANAGED=1"

:: 1. Install Dependencies (setup already installed them into venv)
if exist "venv\Scripts\python.exe" (
    echo [1/4] Using the virtual environment created by setup.
) else (
    echo [1/4] Installing dependencies from requirements.txt...
    python -m pip install -r requirements.txt
    if !ERRORLEVEL! neq 0 (
        echo.
        echo [ERROR] Failed to install dependencies.
        echo Please ensure Python and Pip are installed and in your PATH.
        pause
        exit /b 1
    )
)

if "%MANAGED%"=="1" (
    echo [2/4] Steam API key: managed by setup ^(STEAM_API_KEY in .env^).
    echo [3/4] .env was generated by setup; leaving it unchanged.
    goto launch
)

:: 2. Handle API Key
echo [2/4] Checking Steam API Key...
if not exist apikey.txt (
    echo apikey.txt not found.
    set /p USER_KEY="Please enter your Steam API Key: "
    echo !USER_KEY! > apikey.txt
    set "STEAM_API_KEY=!USER_KEY!"
) else (
    :: Read API Key from file
    for /f "usebackq delims=" %%A in ("apikey.txt") do set "STEAM_API_KEY=%%A"
)

:: Trim spaces (basic)
set "STEAM_API_KEY=%STEAM_API_KEY: =%"

:: 3. Update .env
echo [3/4] Updating .env configuration...
if not exist .env (
    echo Creating new .env file...
    (
        echo STEAM_API_KEY=%STEAM_API_KEY%
        echo STEAM_APP_ID=999860
    ) > .env
) else (
    echo Updating existing .env file...
    set "FOUND_KEY=0"
    (for /f "usebackq tokens=1* delims==" %%A in (".env") do (
        if /I "%%A"=="STEAM_API_KEY" (
            echo STEAM_API_KEY=%STEAM_API_KEY%
            set "FOUND_KEY=1"
        ) else (
            if not "%%B"=="" (
                echo %%A=%%B
            ) else (
                echo %%A
            )
        )
    )) > .env.new

    if "!FOUND_KEY!"=="0" (
        echo STEAM_API_KEY=%STEAM_API_KEY% >> .env.new
    )

    move /y .env.new .env >nul
)

:launch
:: 4. Launch Server (listens on CORE_HOST:CORE_PORT from .env, default 0.0.0.0:8000)
echo [4/4] Launching Andromeda Python Server...
echo.
"%PY%" main.py

if %ERRORLEVEL% neq 0 (
    echo.
    echo [ERROR] Server exited with code %ERRORLEVEL%.
    pause
    exit /b 1
)

pause
